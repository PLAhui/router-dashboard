# 路由器数据看板配置示例
# 复制本文件为 config.env 并填入你的路由器信息（config.env 已被 .gitignore 忽略，不会入库）

# 路由器管理地址（LuCI 首页，不带协议）
ROUTER_HOST=192.168.1.1

# 登录用户名（LuCI 一般为 root）
ROUTER_USER=root

# 管理密码
ROUTER_PASSWORD=your-password-here

# 可选配置
# 服务端口（默认 8787）
# PORT=8787
# 监听地址（默认仅本机 127.0.0.1，如需局域网访问可改为 0.0.0.0，请自行评估风险）
# BIND=127.0.0.1
# 轮询周期毫秒（默认 2000，不建议低于 1000）
# POLL_MS=2000
